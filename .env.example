DEBUG=true
LOG_LEVEL=info

WITH_METRICS=false
METRICS_NAMESPACE=company

WITH_TRACING=false
JAEGER_ADDRESS=

GRPC_PORT=5050
HTTP_PORT=80
HTTP_CORS=true

# Встроенный MCP-сервер для AI-агентов (docs/mcp-server.md)
MCP_ENABLED=false
MCP_PORT=5060
# OAuth-вход MCP-клиентов по адресу (коннекторы Claude); api-ключи работают рядом.
# MCP_PUBLIC_URL — адрес MCP-сервера для клиентов; MCP_OAUTH_ADMIN_URL — админка
# (страница согласия).
MCP_OAUTH_ENABLED=false
MCP_PUBLIC_URL=
MCP_OAUTH_ADMIN_URL=
MCP_OAUTH_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback,https://claude.com/api/mcp/auth_callback,http://localhost,http://127.0.0.1
MCP_OAUTH_ACCESS_TTL=1h
MCP_OAUTH_REFRESH_TTL=720h

PG_DSN="postgres://user:password@localhost:5432/database?sslmode=disable"

# Префикс имён k8s-секретов, создаваемых kusec (плавный переход с helm-секретов)
KUBE_SECRET_NAME_PREFIX=kusec-
